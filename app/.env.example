# Optional local overrides. `npm run dev` reads this file if you copy it to `.env`.
# Production builds already load app/.env.production (the public anon key).
# Anything exported in the shell wins over both files.

# Local `supabase start` prints a different URL and anon key, for example:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<local anon key>
